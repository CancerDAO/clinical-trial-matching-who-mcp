# Select stdio or streamable-http.
WHO_MCP_TRANSPORT=stdio
MCP_REQUEST_TIMEOUT_SECONDS=60
MCP_DETAIL_CONCURRENCY=8
MCP_TRANSIENT_RETRIES=4
MCP_RETRY_BASE_SECONDS=1
WHO_PORTAL_DELTA_MAX_AGE_HOURS=24
WHO_PORTAL_CLOCK_SKEW_MINUTES=5
WHO_MCP_DATABASE_MAX_AGE_HOURS=168
WHO_PORTAL_TIMEOUT_SECONDS=60
WHO_PORTAL_REQUEST_DELAY_SECONDS=0.5
LIVE_REGISTRY_CONCURRENCY=4
LIVE_REGISTRY_TIMEOUT_SECONDS=20
LIVE_REGISTRY_MAX_ERROR_RATE=0.25
# Required for WHO Portal auto mode or direct primary-registry verification.
# This records operator consent; it does not bypass OS, CI, or agent network approval.
EXTERNAL_REGISTRY_ACCESS_AUTHORIZED=0

# Deterministic model executor. The command must read {input} and write strict JSON to {output}.
# Select exactly one backend: api, cli, or custom.
# MODEL_EXECUTION_BACKEND=api
#
# Remote API backend. MODEL_NAME accepts any model identifier supported by the provider.
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-5
# OPENAI_API_KEY=replace-locally
# Supported native/preset providers: openai, anthropic, glm, minimax.
# Any OpenAI-compatible provider:
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=https://provider.example/v1
# MODEL_API_KEY=replace-locally
# MODEL_API_PROTOCOL=openai-chat
# MODEL_API_TIMEOUT_SECONDS=600
# MODEL_API_RETRIES=4
# MODEL_API_RETRY_BASE_SECONDS=1
# MODEL_MAX_INPUT_CHARS=500000
# MODEL_COMPACT_DEEP_PROMPT=1
# MODEL_SKILL_MAX_FILES=50
# MODEL_SKILL_MAX_DEPTH=2
# MODEL_MAX_OUTPUT_TOKENS=16384
# MODEL_TEMPERATURE=0
# MODEL_TOKEN_PARAMETER=max_tokens
# MODEL_ENABLE_JSON_MODE=0
# Stage scheduling. Start conservatively and raise only within provider rate limits.
# MODEL_GATER_BATCH_SIZE=3
# MODEL_DEEP_BATCH_SIZE=2
# MODEL_GATER_CONCURRENCY=3
# MODEL_DEEP_CONCURRENCY=3
# MODEL_MAX_IN_FLIGHT_REQUESTS=3
# Stop submitting new model batches after this many consecutive batch failures.
# MODEL_CIRCUIT_BREAKER_FAILURES=4
# MiniMax Token Plan: China uses https://api.minimaxi.com/v1; international uses
# https://api.minimax.io/v1. Set MODEL_BASE_URL explicitly for sk-cp keys.
# Optional stage-specific API/model overrides:
# GATER_MODEL_PROVIDER=minimax
# GATER_MODEL_NAME=MiniMax-M2.7-highspeed
# GATER_MODEL_API_KEY=replace-locally
# DEEP_MODEL_PROVIDER=openai-compatible
# DEEP_MODEL_NAME=provider-model-id
# DEEP_MODEL_BASE_URL=https://provider.example/v1
# DEEP_MODEL_API_KEY=replace-locally
# DECISION_MODEL_PROVIDER=minimax
# DECISION_MODEL_NAME=MiniMax-M2.7
# DECISION_MODEL_API_KEY=replace-locally
#
# Auditable publication prefetch for deep analysis.
# PUBLICATION_SEARCH_MODE=auto
# PUBLICATION_CONCURRENCY=6
# PUBLICATION_TIMEOUT_SECONDS=20
# PUBLICATION_MAX_RESULTS=5
# Never commit real API keys. Put them in your shell, CI Secret, or an ignored .env file.
#
# Custom deterministic runner:
# MODEL_BATCH_RUNNER_JSON=["python","model_runner.py","--input","{input}","--output","{output}"]
# Or use the bundled stdin/stdout adapter with an installed agent CLI:
# MODEL_AGENT_COMMAND_JSON=["claude","-p","--output-format","text"]
# MODEL_AGENT_TIMEOUT_SECONDS=1800

# Local stdio mode.
WHO_MCP_PYTHON=/absolute/path/to/python3
WHO_MCP_SERVER=/absolute/path/to/who_mcp_server.py
WHO_MCP_DB=/absolute/path/to/who_trials.db

# Remote Streamable HTTP mode. Use HTTPS outside localhost.
# WHO_MCP_TRANSPORT=streamable-http
# WHO_MCP_URL=https://mcp.example.org/mcp
# WHO_MCP_API_KEY=replace-with-a-random-secret
# WHO_MCP_ALLOW_INSECURE_HTTP=0

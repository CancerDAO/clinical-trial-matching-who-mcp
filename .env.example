# Shared transport selection and request timeout.
WHO_MCP_TRANSPORT=stdio
MCP_REQUEST_TIMEOUT_SECONDS=60

# Streamable HTTP only: concurrent get_trial requests.
MCP_DETAIL_CONCURRENCY=8

# WHO portal delta validation, independent of MCP transport.
WHO_PORTAL_DELTA_MAX_AGE_HOURS=24
WHO_PORTAL_CLOCK_SKEW_MINUTES=5

# Local stdio mode.
WHO_MCP_PYTHON=/absolute/path/to/python3
WHO_MCP_SERVER=/absolute/path/to/who_mcp_server.py
WHO_MCP_DB=/absolute/path/to/who_trials.db

# Remote Streamable HTTP mode. Use HTTPS outside localhost.
# WHO_MCP_TRANSPORT=streamable-http
# WHO_MCP_URL=https://mcp.example.org/mcp
# WHO_MCP_API_KEY=replace-with-a-random-secret
# WHO_MCP_ALLOW_INSECURE_HTTP=0
